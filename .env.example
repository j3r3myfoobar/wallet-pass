# Environment Variables Template
# Copy this to .env and fill in your actual values
# NEVER commit the actual .env file to Git!
#
# NOTE: Public configuration is in config.json (committed to repo)
# This file only contains SENSITIVE values that must remain private

# =============================================================================
# SENSITIVE VALUES - Keep these private!
# =============================================================================

# PassKit Authentication - Generate with: openssl rand -base64 32
PASSKIT_AUTH_TOKEN=your-strong-random-token-here

# Apple Developer Team ID - From Apple Developer Console
TEAM_IDENTIFIER=YOUR_TEAM_ID

# Apple Developer Certificate Paths (local development)
PASS_CERT_PATH=./certs/pass.crt
PASS_KEY_PATH=./certs/pass.key
WWDR_CERT_PATH=./certs/wwdr.crt

# APNs Configuration - From Apple Developer Console
APNS_KEY_PATH=./certs/notif.key
APNS_KEY_ID=XXXXXXXXXX

# =============================================================================
# TERRAFORM VARIABLES - Terraform reads TF_VAR_* environment variables
# =============================================================================

# Authentication token (shared between Node.js and Terraform)
TF_VAR_passkit_auth_token=your-strong-random-token-here

# APNs credentials for Terraform (AWS Secrets Manager)
TF_VAR_apns_key_id=XXXXXXXXXX
TF_VAR_apns_team_id=YOUR_TEAM_ID
TF_VAR_apns_bundle_id=pass.tel.lemaire.business
TF_VAR_apns_private_key="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_CONTENT_HERE\n-----END PRIVATE KEY-----"

# AWS region and other Terraform settings
TF_VAR_aws_region=eu-west-3
TF_VAR_log_retention_days=14
TF_VAR_force_destroy_bucket=false


# Pass Versioning (increment for updates)
SERIAL_NUMBER=pass-v5

# =============================================================================
# PERSONAL INFORMATION - Override config.json values if needed
# =============================================================================

# Pass configuration
# PASS_TYPE_IDENTIFIER is critical here. It is like a bunde id for an app and is linked the certificates
PASS_TYPE_IDENTIFIER=pass.com.yourcompany.businesscard 
WEB_SERVICE_URL=https://yourpass.yourdomain.com/
ORGANIZATION_NAME="Your Name"
PASS_DESCRIPTION="Your Name Business Card"
LOGO_TEXT="Your Title"

# Contact information
CONTACT_NAME="Your Name"
CONTACT_EMAIL="your.email@example.com"
CONTACT_PHONE="+1234567890"
CONTACT_LINKEDIN=https://www.linkedin.com/in/yourname/
CONTACT_WEBSITE=https://yourwebsite.com